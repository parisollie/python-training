# Copia este archivo a .env y ajusta los valores
# NUNCA commitees .env con valores reales

# ==== Aplicacion ====
RMO_APP_NAME=Rick & Morty Orders
RMO_APP_VERSION=0.1.0
RMO_ENVIRONMENT=development
RMO_DEBUG=true

# ==== API ====
RMO_HOST=0.0.0.0
RMO_PORT=8000
RMO_CORS_ORIGINS=*

# ==== Base de datos ====
# En desarrollo: sqlite:///./rickmorty_orders.db
# En produccion: postgresql+psycopg://user:password@host:5432/dbname
RMO_DATABASE_URL=sqlite:///./rickmorty_orders.db
RMO_DATABASE_ECHO=false

# ==== Rick and Morty API ====
RMO_RICKMORTY_API_URL=https://rickandmortyapi.com/api
RMO_RICKMORTY_TIMEOUT=10.0
RMO_RICKMORTY_MAX_ATTEMPTS=3

# ==== Seguridad (JWT - futuro) ====
RMO_SECRET_KEY=cambiar-en-produccion-usar-variable-de-entorno
RMO_ALGORITHM=HS256
RMO_ACCESS_TOKEN_EXPIRE_MINUTES=30
